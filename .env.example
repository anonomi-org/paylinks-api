# Anonomi Paylinks API - Environment Configuration
# Copy this file to .env and fill in the values

# Server
PORT=8787
HOST=0.0.0.0
# Docker bind address for the API port (default: 127.0.0.1)
# Set to specific IP if needed (e.g., WireGuard IP for remote access)
BIND_ADDRESS=127.0.0.1

# Database (PostgreSQL)
# For Docker Compose, set POSTGRES_PASSWORD and DATABASE_URL is constructed automatically
# For external DB, set DATABASE_URL directly
POSTGRES_PASSWORD=
DATABASE_URL=postgres://paylinks:${POSTGRES_PASSWORD}@db:5432/paylinks

# CORS - Comma-separated list of allowed origins
# In development, you can use "*" to allow all origins
# In production, this MUST be set to your actual domains
ALLOWED_ORIGINS=https://paylinks.anonomi.org,https://anonomi.org

# Allow null origin - ONLY for Tor deployments
# Tor Browser sends "null" as the Origin header for privacy.
# Set to "true" only on Tor hidden service deployments.
# ALLOW_NULL_ORIGIN=true

# Donate page base URL - REQUIRED in production
# The paylink ID will be appended as a fragment (e.g., https://example.org/donate#<id>)
# For Tor: http://your-onion-address.onion/paylinks/d#
DONATE_BASE_URL=https://anonomi.org/paylinks/d#

# NOTE: PAYLINKS_MASTER_KEY_B64 is gone. Private view keys are no longer stored,
# so there is nothing left to encrypt. Subaddresses are derived once when a
# paylink is created and the key is discarded before the response is sent.

# Fingerprint HMAC key - REQUIRED in production
# Used to generate paylink fingerprints for verification
# Any string >= 16 characters. Generate with: openssl rand -hex 32
PAYLINKS_FINGERPRINT_KEY=

# --- Where this service sits on the network --------------------------------
# None of the following can be detected at runtime, and guessing wrong is
# harmful in both directions, so declare it.

# Trust X-Forwarded-For. Leave OFF unless a reverse proxy really is in front.
#
# Fastify derives the client address from this header only when this is set.
# With no proxy in front, turning it on lets any caller claim any address,
# which forges the rate-limit key and removes rate limiting altogether.
#
#   unset / false  direct exposure, or a Tor hidden service
#   true           behind a proxy you control
#   <number>       trust this many hops from the right
#   <list>         comma-separated trusted addresses or subnets
#
# On a hidden service leave this off: Tor supplies no client address to recover,
# so every request shares one bucket no matter what is configured here.
# TRUST_PROXY=true

# --- Rate limits -----------------------------------------------------------
# Reads. Per client where the address is real, service-wide on Tor.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW=1 minute

# Creating a paylink derives its entire address pool - up to ~400ms of CPU and
# ~93KB, unauthenticated. On a hidden service an abuser cannot be identified or
# blocked, so this ceiling is the only thing in front of that cost.
# RATE_LIMIT_CREATE_MAX=20

# Donation requests, counted per paylink, so one link cannot have its address
# pool harvested. A donation page spends exactly one per visit.
# RATE_LIMIT_REQUEST_MAX=60

# --- HSTS ------------------------------------------------------------------
# Off by default, and deliberately independent of ALLOW_NULL_ORIGIN.
#
# A hidden service is plain HTTP and must never send this. A clearnet
# deployment behind TLS usually should. It is also close to irreversible: a
# browser that has seen the header honours it for the whole max-age regardless
# of what the server does afterwards, so backing it out means serving
# max-age=0 and waiting for every client to come back.
# ENABLE_HSTS=true
# HSTS_MAX_AGE=31536000

# Commits every sibling subdomain to HTTPS for the same duration. Separate
# because it is not a decision to inherit from a default.
# HSTS_INCLUDE_SUBDOMAINS=true

# Environment
# Set to "production" in production to enable strict validation
NODE_ENV=development
